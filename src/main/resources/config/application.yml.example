# External application overrides for StoreIt (copy to ./config/application.yml)
# Loaded before ./config/admin.yml. Duplicate keys in admin.yml win (keep the admin password there).
# You can override any Spring Boot or `app.*` property here when running the jar.

server:
  # HTTP(S) listening port (1 - 65535)
  port: 59898
  servlet:
    session:
      # Spring servlet container session timeout (ISO-8601 duration, e.g. 30d, 12h, 60m)
      timeout: 30d
  ssl:
    # Enable direct HTTPS/SSL on this server. If true, configure keystore below
    enabled: false
    # Path to PKCS12/JKS keystore file (relative to working directory)
    key-store: ./keystore.p12
    # Keystore access password
    key-store-password: changeit
    # Keystore type (usually PKCS12)
    key-store-type: PKCS12

spring:
  datasource:
    # SQLite database file location
    url: jdbc:sqlite:./data/storeit.db
    driver-class-name: org.sqlite.JDBC
  flyway:
    enabled: true
    locations: classpath:db/migration
  servlet:
    multipart:
      # Max single file upload size (e.g. 100GB, 10GB, 500MB)
      max-file-size: 100GB
      # Max multipart request size (e.g. 100GB, 10GB, 500MB)
      max-request-size: 100GB

app:
  # Root folder on disk for user files served by the app
  storage-root: storage
  # Whether to mark session cookie as Secure and send HSTS header (enable for direct SSL or HTTPS reverse proxy)
  ssl-enabled: false
  # Refuse to start while the built-in default admin password (admin / authorized_users) is still in use
  require-custom-admin: false
  login:
    # Lock login for same IP + username after N consecutive failures
    max-failures: 5
    # Sliding time window (minutes) for counting login failures
    window-minutes: 15
  session:
    # Session max age (days, 1 - 365) used for session & cookie expiry
    max-age-days: 30
    # Cookie name for session token
    cookie-name: STOREIT_SESSION

logging:
  level:
    # Root log level (info / warn / error / debug / trace)
    root: info
